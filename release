#!/usr/bin/env bash
set -euo pipefail

# Simple release script for repo-sync
# Usage: ./release <version>
# Example: ./release 0.2.0
#
# This only bumps the version and commits the change on the current
# branch; it does not tag or push. Tag the merge commit on main
# after the resulting PR has been merged (see the printed
# instructions at the end).

if [ $# -ne 1 ]; then
  echo "Usage: $0 <version>"
  echo "Example: $0 0.2.0"
  exit 1
fi

VERSION="$1"

# Validate version format
if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: Version must be in format X.Y.Z (e.g., 1.0.0)"
  exit 1
fi

# Refuse to run on main: this script only prepares a release commit on
# a feature branch, which then goes through a PR.
current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" = "main" ]; then
  echo "Error: don't run this on main. Create a branch first, e.g.:" >&2
  echo "  git switch -c release/$VERSION" >&2
  exit 1
fi

echo "Preparing release $VERSION..."

# Update only the [package] version line in Cargo.toml (the first
# "version = " line), leaving any later "version = " line (e.g. in
# [dependencies] or a [dependencies.foo] table) untouched. The
# trailing ";" before the closing "}" is required: BSD/macOS sed
# (unlike GNU sed) treats a bare "}" right after the substitute
# command as part of it and errors with "bad flag in substitute
# command: '}'".
sed -i.bak '/^\[package\]/,/^\[/{s/^version = .*/version = "'"$VERSION"'"/;}' Cargo.toml
rm -f Cargo.toml.bak

# Run tests
echo "Running tests..."
cargo test

echo "Committing release $VERSION..."
git add Cargo.toml Cargo.lock

# Only commit if there are changes
if ! git diff --cached --quiet; then
  git commit -m "Release $VERSION"
fi

cat <<EOF

Next steps:
  1. Open a PR for this branch and get it merged into main.
  2. After it merges, tag the merge commit and push the tag:

       git switch main && git pull --ff-only && git tag -s $VERSION -m "Release $VERSION" && git push origin $VERSION
EOF
